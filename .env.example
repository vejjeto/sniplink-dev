# Local zero-config SQLite database (auto-created on startup or db:migrate)
DATABASE_URL="file:./data/app.db"

# Optional PostgreSQL connection string for production / Docker Compose
POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/sniplink"

# Base URL used for generated short links and QR codes
NEXT_PUBLIC_APP_URL="http://localhost:3001"

WEBHOOK_URL="http://localhost:3009/api/hook/ecosystem-bin"
WEBHOOK_SECRET="portfolio-ecosystem-dev-secret"
